# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ─── Dependencies ────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# pnpm
.pnpm-store/
pnpm-debug.log*

# ─── Next.js ─────────────────────────────────────────────────────────────────
/.next/
/out/

# ─── Build Output ────────────────────────────────────────────────────────────
/build
/dist

# ─── Testing & Coverage ──────────────────────────────────────────────────────
/coverage
/.nyc_output

# ─── Environment Variables ───────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.template

# ─── Debug Logs ──────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Vercel ──────────────────────────────────────────────────────────────────
.vercel

# ─── OS Generated Files ──────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ─── Editor & IDE ────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
*.suo
*.user
*.userosscache
*.sln.docstates

# ─── Security ────────────────────────────────────────────────────────────────
*.pem
*.key
*.cert
*.p12

# ─── Misc ────────────────────────────────────────────────────────────────────
.cache/
.turbo/
*.local
